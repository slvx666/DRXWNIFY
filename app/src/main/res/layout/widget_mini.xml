<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 player in the classic widget's look: blurred cover with the progress glow behind, the
     cover, title and artist, play/pause. Drawn by MetrolistWidgetManager.miniFaces. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/mini_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/wd_bg_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/mini_cover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/mini_texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="#FFEEF2F8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mini_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF9AA3B2"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/mini_play"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/wd_play_bg"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/wd_play" />
    </LinearLayout>
</FrameLayout>
