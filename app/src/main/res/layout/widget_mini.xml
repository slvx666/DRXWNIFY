<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 player: the cover blurred behind (as on the 2x2); title and artist on top over the full
     width, previous / play / next in the middle, the progress line at the bottom.
     Drawn by MetrolistWidgetManager.miniFaces. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/mini_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/wd_bg_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="7dp"
        android:paddingEnd="11dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/mini_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mini_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C8FFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mini_prev"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/previous"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:src="@drawable/wd_prev" />

            <ImageView
                android:id="@+id/mini_play"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_play" />

            <ImageView
                android:id="@+id/mini_next"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/next"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:src="@drawable/wd_next" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/mini_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="1000"
            android:progressDrawable="@drawable/wd_square_progress" />
    </LinearLayout>
</FrameLayout>
