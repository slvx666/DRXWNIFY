<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/classic_widget_bg"
    android:orientation="horizontal"
    android:padding="12dp">
    <ImageView android:id="@+id/classic_cover" android:layout_width="wrap_content" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="@null" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/classic_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/classic_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#B3FFFFFF" android:textSize="12sp" />
        <ProgressBar android:id="@+id/classic_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:max="1000" android:progressDrawable="@drawable/classic_progress" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <ImageView android:id="@+id/classic_like" android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:contentDescription="@null" android:src="@drawable/ic_widget_heart_outline_nav" />
            <ImageView android:id="@+id/classic_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:contentDescription="@string/previous" android:src="@drawable/ic_widget_skip_previous" />
            <ImageView android:id="@+id/classic_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:contentDescription="@string/play" android:src="@drawable/ic_widget_play" />
            <ImageView android:id="@+id/classic_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:contentDescription="@string/next" android:src="@drawable/ic_widget_skip_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
