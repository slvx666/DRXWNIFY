<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/classic_bg"
        android:src="@drawable/wd_bg_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/classic_cover"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/classic_texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/classic_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="#FFEEF2F8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/classic_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF9AA3B2"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/classic_like"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/wd_heart" />

        <ImageView
            android:id="@+id/classic_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/previous"
            android:padding="4dp"
            android:src="@drawable/wd_prev" />

        <ImageView
            android:id="@+id/classic_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/wd_play_bg"
            android:contentDescription="@string/play"
            android:padding="10dp"
            android:src="@drawable/wd_play" />

        <ImageView
            android:id="@+id/classic_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/next"
            android:padding="4dp"
            android:src="@drawable/wd_next" />
    </LinearLayout>
</FrameLayout>
