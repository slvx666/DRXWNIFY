<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed at 4x1: stretched, the row looked broken on many launchers. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:previewImage="@drawable/widget_preview_classic"
    android:previewLayout="@layout/widget_preview_classic"
    android:initialLayout="@layout/widget_classic_row"
    android:description="@string/widget_classic_desc"
    android:widgetCategory="home_screen|keyguard"
    android:resizeMode="none" />
